ENVIRONMENT=development
BACKEND_URL=http://localhost:8084
FRONTEND_URL=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=vee
POSTGRES_USER=vee
POSTGRES_PWD=replace-me
DATABASE_SSLMODE=prefer
DATABASE_CONNECT_TIMEOUT=10
DATABASE_COMMAND_TIMEOUT=30
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_ACQUIRE_TIMEOUT=10

SECRET_JWT_KEY=replace-with-at-least-32-random-characters
CHECKOUT_HMAC_KEY=replace-with-an-independent-32-character-key
MFA_ENCRYPTION_KEY=replace-with-an-independent-32-character-key
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
MAX_REQUEST_BODY_BYTES=6291456

MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_FROM=no-reply@example.com
